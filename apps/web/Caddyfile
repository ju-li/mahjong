{
	admin off
	auto_https off
}

# Railway injects PORT; default to 8080 for local `docker run`.
:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	# Vite emits content-hashed files under /assets; everything else (index.html) must revalidate.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@unhashed not path /assets/*
	header @unhashed Cache-Control "no-cache"

	# SPA fallback: unknown paths serve index.html.
	try_files {path} /index.html
	file_server
}
